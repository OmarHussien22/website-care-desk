======================== resources ========================

RequestResource {
  - id => int
  - projectTitle => String
  - type => ProjectTypeResource
  - projectCode => String
  - date => String
  - status => int  (1 => new && 2 => under_study && 3 => confirmed)
  - projectEngineer => String
  - phone => String
  - email => String
}
ProjectTypeResource {
    - id => int
    - title => String
}
ProjectScopeResource {
    - id => int
    - title => String
    - icon_url => String
    - completed_requirements_count => int
    - total_requirements_count => int
}

ConsultationResource {
    - id => int
    - department => departmentResource
    - branch => BranchResource
    - consulation_type => int (1 => online & 2 => offline)
    - description => string
    - status => int (1 => sent & 2 => pending & 3 => cancelled & 4 => confirmed & 5 => finishied)
    - create_date => String
    - meeting_date => String
    - attention => AttentionResource
    - meeting_link => String
    - meeting_time => String
    - meeting_summary => AttachmentResource. // only not null in finished
}
AttentionResource {
    - id => int
    - name => String
}

DepartmentResource {
    - id => int
    - title => String
}
BranchResource {
    - id => int
    - title => String
}
RequirementItemResource{
    - id => int
    - title => String
    - sub_title => String
    - uploading_date => String
    - attachment_status => int. (1 => not_submitted & 2 => submitted & 3 => approved & 4 => rejected)
}
AttachmentResource{
    - id => int
    - title => String
    - url => String
}

OfferResrouces{
    - id => int
    - title=> String
    - project_type=> ProjectTypeResource
    - project_code=> String
    - last_update=> String
    - project_status=> int  (6 => hold&& 4 => rejected && 8=> waiting l.p.o && 3 => approved)
    - total=> String
    - total_area=> String
    - duration_by_weeks=> String
    - discount=> String
    - earning_points=> String
    - address=> String
    - attentions=> AttentionResource 
    - total_offer=> String
}

ProductivityResource{
    - id => int
    - project => ProjectResource
    - date => String
    - duration => String
    - total_area => String
    - attention => AttentionResource
    - design => ScopeProductivityResource
    - authority => ScopeProductivityResource
    - drafting => ScopeProductivityResource
}

ScopeProductivityResource{
  - progress => int             // in case hte scope productivity presentage
  - requirements_count => int   // In case the scope productivity Steps
  - completed_count => int      // In case the scope productivity Steps
}

BannerResource {
    - id => int
    - image => String
    - url => String
}

PointsInfoResource {
    - points_balance => int
    - total_points_value => double
}

DocumentResource{
    - id => int
    - title => String
    - project_code => String
    - description => String
    - client_serial => String
    - attachments => List<AttachmentResource>
}
